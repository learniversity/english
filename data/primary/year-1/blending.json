{
  "id": "primary-1-blending",
  "title": "Blending and Segmenting Sounds",
  "level": "primary-1",
  "category": "Phonics",
  "introduction": "Practise blending and segmenting sounds with familiar words and short sentences.",
  "definition": "Blending joins sounds to read a word. Segmenting separates a word into sounds to help spell it.",
  "rules": [
    "Blend short words with different vowels before moving to consonant clusters.",
    "Say each sound without adding an extra vowel. In flag, hear f, l, the short a sound and g.",
    "Blend /s/ /i/ /t/ to read sit.",
    "Say stop slowly: /s/ /t/ /o/ /p/. Each sound matters."
  ],
  "grammar": [],
  "vocabulary": [],
  "examples": [
    {
      "question": "Blend d-r-u-m.",
      "steps": [
        "Join d and r, then u and m."
      ],
      "answer": "drum"
    },
    {
      "question": "Blend c-l-a-p.",
      "steps": [
        "Blend four sounds in order."
      ],
      "answer": "clap"
    },
    {
      "question": "Segment the word milk.",
      "steps": [
        "Say each sound separately."
      ],
      "answer": "m-i-l-k"
    },
    {
      "question": "Blend s-w-i-m.",
      "steps": [
        "Keep the initial s and w sounds."
      ],
      "answer": "swim"
    },
    {
      "question": "Blend g-r-e-e-n.",
      "steps": [
        "The letters ee represent one long vowel sound."
      ],
      "answer": "green"
    }
  ],
