  "id": "primary-1-animals",
  "title": "Animals and Their Features",
  "level": "primary-1",
  "category": "Vocabulary",
  "introduction": "Practise animals and their features with familiar words and short sentences.",
  "definition": "Describe animals using names, colours, body parts and simple actions.",
  "rules": [
    "Say what an animal can do.",
    "Describe one feature at a time.",
    "Say: A goat has horns.",
    "Say: A duck can swim.",
    "Say: A butterfly has wings.",
    "Say: An elephant has a trunk.",
    "Say: A tiger has stripes.",
    "Say: A sheep has wool.",
    "Say: A crocodile has sharp teeth.",
    "Say: An octopus has eight arms.",
    "Say: A dolphin lives in the sea.",
    "Say: An ant is small."
  ],
