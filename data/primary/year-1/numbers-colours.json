  "examples": [
    {
      "question": "How do you write 12?",
      "steps": [
        "Learn this spelling as a whole word."
      ],
      "answer": "twelve"
    },
    {
      "question": "How do you write 40?",
      "steps": [
        "There is no u in forty."
      ],
      "answer": "forty"
    },
    {
      "question": "Describe four green leaves.",
      "steps": [
        "Use the number, colour and plural noun."
      ],
      "answer": "four green leaves"
    },
    {
