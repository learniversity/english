{
  "id": "primary-1-questions",
  "title": "Simple Questions and Answers",
  "level": "primary-1",
  "category": "Speaking",
  "introduction": "Practise simple questions and answers with familiar words and short sentences.",
  "definition": "Questions help us find out information. Answer using a short phrase or sentence.",
  "rules": [
    "Use what to ask about things, who for people, where for places, when for time and how for ways or feelings.",
    "Use how many to ask about numbers and how old for age.",
    "Questions beginning with is, are, can or do can often be answered with yes or no."
  ],
  "grammar": [
    {
      "expression": "What?",
      "description": "What is this?"
    },
    {
      "expression": "Who?",
      "description": "Who is your teacher?"
    },
    {
      "expression": "Where?",
      "description": "Where is your bag?"
    },
    {
      "expression": "When?",
      "description": "When is your birthday?"
    },
    {
      "expression": "How?",
      "description": "How are you?"
    },
    {
      "expression": "How many?",
      "description": "How many books are there?"
    },
    {
      "expression": "How old?",
      "description": "How old are you?"
    },
    {
      "expression": "Yes/no questions",
      "description": "Is it blue? Can you swim?"
    }
  ],
  "vocabulary": [],
  "examples": [
    {
      "question": "Ask for the name of an object.",
      "steps": [
        "Use what for a thing."
      ],
      "answer": "What is this?"
    },
    {
      "question": "Ask about a person's identity.",
      "steps": [
        "Use who for a person."
      ],
      "answer": "Who is that?"
    },
    {
      "question": "Ask for the place of the schoolbag.",
      "steps": [
        "Use where for a place."
      ],
      "answer": "Where is the schoolbag?"
    },
    {
      "question": "Ask about the number of pencils.",
      "steps": [
        "Use how many for a quantity."
      ],
      "answer": "How many pencils are there?"
    },
    {
      "question": "Answer 'Is the door open?' if it is.",
      "steps": [
        "Use a short affirmative answer."
      ],
      "answer": "Yes, it is."
    }
  ],
