{
  "id": "primary-1-articles",
  "title": "A and An",
  "level": "primary-1",
  "category": "Grammar",
  "introduction": "Practise a and an with familiar words and short sentences.",
  "definition": "Use a or an before a single countable thing when it is not already identified. Choose by the next sound.",
  "rules": [
    "Use a before a consonant sound and an before a vowel sound.",
    "Listen to the first sound, not just the first written letter.",
    "For one countable thing: a mango, an egg. Do not normally use a or an before plural nouns.",
    "Use a before a consonant sound: a book.",
    "Use an before a vowel sound: an apple."
  ],
  "grammar": [
    {
      "expression": "a + consonant sound",
      "description": "a ruler, a kitten, a uniform"
    },
    {
      "expression": "an + vowel sound",
      "description": "an umbrella, an insect, an hour"
    }
  ],
  "vocabulary": [],
  "examples": [
    {
      "question": "Choose an article for orange.",
      "steps": [
        "Orange begins with a vowel sound."
      ],
      "answer": "an orange"
    },
    {
      "question": "Choose an article for bicycle.",
      "steps": [
        "Bicycle begins with a consonant sound."
      ],
      "answer": "a bicycle"
    },
    {
      "question": "Choose an article for uniform.",
      "steps": [
        "Uniform starts with a /y/ sound."
      ],
      "answer": "a uniform"
    },
    {
      "question": "Choose an article for hour.",
      "steps": [
        "The h is silent in hour."
      ],
      "answer": "an hour"
    },
    {
      "question": "Choose an article for insect.",
      "steps": [
        "Insect begins with a vowel sound."
      ],
      "answer": "an insect"
    }
  ],
