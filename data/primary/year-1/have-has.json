{
  "id": "primary-1-have-has",
  "title": "Have and Has",
  "level": "primary-1",
  "category": "Grammar",
  "introduction": "Practise have and has with familiar words and short sentences.",
  "definition": "Have and has help us talk about possessions and features.",
  "rules": [
    "Use have with I, you, we and they. Use has with he, she, it and a single person or thing.",
    "Use have and has for belongings, family relationships and animal features.",
    "When asking with does, use have: Does she have a pencil?"
  ],
  "grammar": [
    {
      "expression": "I / you / we / they have",
      "description": "We have two umbrellas."
    },
    {
      "expression": "He / she / it has",
      "description": "The elephant has a trunk."
    },
    {
      "expression": "Questions",
      "description": "Do you have a ruler? Does she have a book?"
    }
  ],
  "vocabulary": [],
  "examples": [
    {
      "question": "Complete: We ___ a new ball.",
      "steps": [
        "We takes have."
      ],
      "answer": "have"
    },
    {
      "question": "Complete: The goat ___ horns.",
      "steps": [
        "The goat is singular."
      ],
      "answer": "has"
    },
    {
      "question": "Complete: My grandparents ___ a garden.",
      "steps": [
        "Grandparents is plural."
      ],
      "answer": "have"
    },
    {
      "question": "Ask whether Ali owns a kite.",
      "steps": [
        "Use have after does."
      ],
      "answer": "Does Ali have a kite?"
    },
    {
      "question": "Complete: My sister ___ a blue bag.",
      "steps": [
        "My sister is singular."
      ],
      "answer": "has"
    }
  ],
