  "introduction": "Practise have and has with familiar words and short sentences.",
  "definition": "Have and has help us talk about possessions and features.",
  "rules": [
    "Use have with I, you, we and they.",
    "Use has with he, she and it."
  ],
  "grammar": [
    {
      "expression": "I have a bag.",
      "description": "Say what you own."
    },
    {
      "expression": "It has a tail.",
      "description": "Describe an animal."
    }
  ],
  "vocabulary": [],
  "examples": [
    {
      "question": "I ___ a pencil.",
      "steps": [
        "Use have with I, you, we and they."
      ],
      "answer": "have"
    },
    {
      "question": "A cat ___ a tail.",
      "steps": [
        "Use has with he, she and it."
      ],
      "answer": "has"
    }
