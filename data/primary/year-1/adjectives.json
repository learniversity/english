{
  "id": "primary-1-adjectives",
  "title": "Describing Words",
  "level": "primary-1",
  "category": "Grammar",
  "introduction": "Practise describing words with familiar words and short sentences.",
  "definition": "Describing words tell us what something is like, for example its colour or size.",
  "rules": [
    "Adjectives describe people, animals, places and things.",
    "Learn useful pairs: big/small, tall/short, long/short, hot/cold, clean/dirty, fast/slow, heavy/light, hard/soft, old/new, full/empty.",
    "Describe things with size, colour, texture, temperature and feelings.",
    "Put a describing word before a noun: a small cat.",
    "You can also use it after is: The cat is small."
  ],
  "grammar": [
    {
      "expression": "adjective + noun",
      "description": "a soft pillow, a long road, a red bag"
    },
    {
      "expression": "be + adjective",
      "description": "The soup is hot. The shoes are clean."
    }
  ],
  "vocabulary": [
    {
      "expression": "tall",
      "description": "Having great height."
    },
    {
      "expression": "short",
      "description": "Not tall or not long."
    },
    {
      "expression": "heavy",
      "description": "Having a lot of weight."
    },
    {
      "expression": "light",
      "description": "Not heavy."
    },
    {
      "expression": "soft",
      "description": "Not hard."
    },
    {
      "expression": "hard",
      "description": "Firm or solid."
    },
    {
      "expression": "clean",
      "description": "Not dirty."
    },
    {
      "expression": "dirty",
      "description": "Not clean."
    },
    {
      "expression": "fast",
      "description": "Moving quickly."
    },
    {
      "expression": "slow",
      "description": "Not fast."
    },
    {
      "expression": "full",
      "description": "Containing as much as possible."
    },
    {
      "expression": "empty",
      "description": "Containing nothing."
    },
    {
      "expression": "new",
      "description": "Recently made or obtained."
    },
    {
      "expression": "old",
      "description": "Having existed for a long time."
    },
    {
      "expression": "wet",
      "description": "Covered with liquid."
    },
    {
      "expression": "dry",
      "description": "Not wet."
    }
  ],
  "examples": [
    {
      "question": "Describe a pillow that feels gentle to touch.",
      "steps": [
        "Soft describes texture."
      ],
      "answer": "a soft pillow"
    },
    {
      "question": "Find the adjective: The train is fast.",
      "steps": [
        "Fast describes the train."
      ],
      "answer": "fast"
    },
    {
      "question": "What is the opposite of dirty?",
      "steps": [
        "These words have contrasting meanings."
      ],
      "answer": "clean"
    },
    {
      "question": "Describe a bag containing nothing.",
      "steps": [
        "Empty describes its contents."
      ],
      "answer": "an empty bag"
    },
    {
      "question": "Describe a soup with a high temperature.",
      "steps": [
        "Hot describes temperature."
      ],
      "answer": "hot soup"
    }
  ],
