{
  "id": "primary-1-plurals",
  "title": "One and Many",
  "level": "primary-1",
  "category": "Grammar",
  "introduction": "Practise one and many with familiar words and short sentences.",
  "definition": "Singular words name one thing. Plural words name more than one.",
  "rules": [
    "Add -s to many nouns. Add -es to many nouns ending in s, sh, ch or x.",
    "Some plurals change their spelling, such as baby → babies and child → children.",
    "Use a singular noun for one and a plural noun for more than one.",
    "Many plural nouns end in s: book, books.",
    "Some end in es: box, boxes."
  ],
  "grammar": [
    {
      "expression": "-s",
      "description": "cup → cups; toy → toys"
    },
    {
      "expression": "-es",
      "description": "bus → buses; dish → dishes; box → boxes"
    },
    {
      "expression": "Consonant + y",
      "description": "baby → babies; puppy → puppies"
    },
    {
      "expression": "Common irregular plurals",
      "description": "child → children; foot → feet; tooth → teeth; person → people"
    }
  ],
  "vocabulary": [],
  "examples": [
    {
      "question": "Make the plural of dish.",
      "steps": [
        "Add es after sh."
      ],
      "answer": "dishes"
    },
    {
      "question": "Make the plural of toy.",
      "steps": [
        "Add s after vowel + y."
      ],
      "answer": "toys"
    },
    {
      "question": "Make the plural of puppy.",
      "steps": [
        "Change consonant + y to ies."
      ],
      "answer": "puppies"
    },
    {
      "question": "Make the plural of child.",
      "steps": [
        "This is an irregular plural."
      ],
      "answer": "children"
    },
    {
      "question": "Make the plural of foot.",
      "steps": [
        "Learn the changed vowel spelling."
      ],
      "answer": "feet"
    }
  ],
