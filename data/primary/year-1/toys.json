{
  "id": "primary-1-toys",
  "title": "Toys and Belongings",
  "level": "primary-1",
  "category": "Vocabulary",
  "introduction": "Practise toys and belongings with familiar words and short sentences.",
  "definition": "We can name toys and say who owns them.",
  "rules": [
    "Point to toys and describe them.",
    "Use my for something that belongs to you.",
    "Say: I fly my kite.",
    "Say: She has a dollhouse.",
    "Say: He rides his bicycle.",
    "Say: We play a board game.",
    "Say: My robot is silver.",
    "Say: Your puzzle has many pieces.",
    "Say: The teddy bear is soft.",
    "Say: They jump with a skipping rope."
  ],
  "grammar": [
    {
      "expression": "My kite",
      "description": "A kite that belongs to me."
    },
    {
      "expression": "Your ball",
      "description": "A ball that belongs to the person I am speaking to."
    }
  ],
