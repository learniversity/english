{
  "id": "primary-1-can",
  "title": "Can and Cannot",
  "level": "primary-1",
  "category": "Grammar",
  "introduction": "Practise can and cannot with familiar words and short sentences.",
  "definition": "Use can to say what someone is able to do and cannot to say what they are not able to do.",
  "rules": [
    "Use can with the base form of an action word: can swim, can read, can ride.",
    "Use cannot or can't to express inability.",
    "Ask Can you ...? and answer Yes, I can or No, I cannot."
  ],
  "grammar": [
    {
      "expression": "can + verb",
      "description": "I can draw a picture."
    },
    {
      "expression": "cannot + verb",
      "description": "A penguin cannot fly."
    },
    {
      "expression": "Can + subject + verb?",
      "description": "Can you ride a bicycle?"
    },
    {
      "expression": "Short replies",
      "description": "Yes, I can. No, I cannot."
    }
  ],
  "vocabulary": [
    {
      "expression": "climb",
      "description": "Move upwards."
    },
    {
      "expression": "swim",
      "description": "Move through water."
    },
    {
      "expression": "ride",
      "description": "Travel on or in something."
    },
    {
      "expression": "paint",
      "description": "Make a picture with paint."
    },
    {
      "expression": "carry",
      "description": "Move something while holding it."
    },
    {
      "expression": "skip",
      "description": "Jump lightly or use a skipping rope."
    },
    {
      "expression": "catch",
      "description": "Stop and hold a moving object."
    },
    {
      "expression": "throw",
      "description": "Send something through the air by hand."
    }
  ],
  "examples": [
    {
      "question": "Complete: A monkey can ___ a tree.",
      "steps": [
        "Use the base form of climb."
      ],
      "answer": "climb"
    },
    {
      "question": "Say that you are able to ride a bicycle.",
      "steps": [
        "Use can followed by ride."
      ],
      "answer": "I can ride a bicycle."
    },
    {
      "question": "Say that penguins are not able to fly.",
      "steps": [
        "Cannot expresses inability."
      ],
      "answer": "Penguins cannot fly."
    },
    {
      "question": "Ask about someone's ability to draw.",
      "steps": [
        "Start a question with can."
      ],
      "answer": "Can you draw?"
    },
    {
      "question": "Answer 'Can you sing?' positively.",
      "steps": [
        "Use a short affirmative reply."
      ],
      "answer": "Yes, I can."
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "A fish can ___ (swim or swims).",
      "answer": "swim",
      "solution": "Answer: swim"
    },
    {
      "id": "q2",
      "type": "text",
      "question": "A penguin ___ fly. (can or cannot)",
      "answer": "cannot",
      "solution": "Answer: cannot"
    },
    {
      "id": "q3",
      "type": "text",
      "question": "I can ___ a picture. (paint or paints)",
      "answer": "paint",
      "solution": "Answer: paint"
    },
    {
      "id": "q4",
      "type": "text",
      "question": "___ you catch a ball?",
      "answer": "Can",
      "solution": "Answer: Can"
    },
    {
      "id": "q5",
      "type": "text",
      "question": "A horse can ___. (run or runs)",
      "answer": "run",
      "solution": "Answer: run"
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Complete: No, I ___. (cannot or does not)",
      "answer": "cannot",
      "solution": "Answer: cannot"
    },
    {
      "id": "q7",
      "type": "text",
      "question": "A butterfly can ___ (fly or flies).",
      "answer": "fly",
      "solution": "Answer: fly"
    },
    {
      "id": "q8",
      "type": "text",
      "question": "She can ___ a bicycle. (ride or rides)",
