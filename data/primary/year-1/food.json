{
  "id": "primary-1-food",
  "title": "Food and Drinks",
  "level": "primary-1",
  "category": "Vocabulary",
  "introduction": "Practise food and drinks with familiar words and short sentences.",
  "definition": "Use English to name food and drinks and express likes and dislikes.",
  "rules": [
    "Practise asking what someone likes.",
    "Use polite words when asking for food.",
    "Say: I like mangoes.",
    "Say: I do not like onions.",
    "Say: I have a sandwich.",
    "Say: I want some water.",
    "Say: This is a carrot.",
    "Say: Do you like bananas?",
    "Say: May I have some milk, please?",
    "Say: The soup is hot.",
    "Say: These grapes are sweet.",
    "Say: We eat rice and tofu.",
    "Say: My brother likes noodles.",
    "Say: She drinks juice."
  ],
  "grammar": [
    {
      "expression": "I like rice.",
      "description": "Express a preference."
    },
    {
      "expression": "I do not like tea.",
      "description": "Express a negative preference."
    },
    {
      "expression": "Do you like milk?",
      "description": "Ask about a preference."
    }
  ],
