  "level": "preschool",
  "category": "Phonics",
  "introduction": "Explore all 26 letters from A to Z. Each card shows a capital letter, a small letter and three example words. Pictures are included where suitable.",
  "definition": "English has 26 letters. Each letter has an uppercase and a lowercase form.",
  "rules": [
    "Read and name the first letter of each word. Letters have names and may represent more than one sound.",
    "Practise finding uppercase and lowercase letters in books, labels and signs.",
    "Say the capital and small letters on each card.",
    "Name the three examples. Notice the first letter in each written word.",
    "Letters can represent different sounds. For example, xylophone starts with the letter X but often sounds like Z.",
    "Say the letters in order.",
    "Match capital letters to small letters."
  ],
  "grammar": [],
  "vocabulary": [],
  "examples": [
    {
      "question": "Which letter comes after F?",
      "steps": [
        "Say E, F, G, H."
      ],
      "answer": "G"
    },
    {
      "question": "What is the small form of T?",
      "steps": [
        "Capital T and small t are the same letter."
      ],
      "answer": "t"
    },
    {
      "question": "Which letter begins the word queen?",
      "steps": [
        "Look at the first letter in queen."
      ],
      "answer": "Q"
    },
    {
      "question": "Which letter comes before Z?",
      "steps": [
        "Say W, X, Y, Z."
      ],
      "answer": "Y"
    }
  ],
