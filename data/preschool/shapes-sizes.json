      "description": "A shape with four straight sides and square corners."
    },
    {
      "expression": "oval",
      "description": "A rounded shape like the outline of an egg."
    },
    {
      "expression": "star",
      "description": "A familiar shape with points."
    },
    {
      "expression": "round",
      "description": "Shaped like a circle or ball."
    },
    {
