      "description": "Having a great length."
    },
    {
      "expression": "short",
      "description": "Not long or not tall."
    },
    {
      "expression": "tall",
      "description": "Having great height."
    },
    {
      "expression": "wide",
      "description": "Having a large distance from side to side."
    },
    {
      "expression": "narrow",
      "description": "Not wide."
    }
  ],
  "rules": [
    "Point to each shape and say its name.",
    "Look around for objects with similar shapes.",
    "Compare two objects and use words such as big, small, long or short."
  ],
  "examples": [
    {
      "question": "What shape is the face of a round clock?",
      "steps": [
        "Choose the word that describes the object."
      ],
      "answer": "circle"
    },
    {
      "question": "Describe a little button.",
      "steps": [
        "Choose the word that describes the object."
      ],
      "answer": "small"
    },
    {
      "question": "Describe a tree that reaches high.",
      "steps": [
        "Choose the word that describes the object."
      ],
      "answer": "tall"
    },
    {
      "question": "What shape has three sides?",
      "steps": [
        "Choose the word that describes the object."
      ],
      "answer": "triangle"
    },
    {
      "question": "Describe a ribbon that reaches far.",
      "steps": [
        "Choose the word that describes the object."
      ],
      "answer": "long"
    }
  ],
  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "Which shape has three straight sides?",
      "answer": "triangle",
      "solution": "A triangle is a flat shape with three straight sides."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "Which shape is round like a coin?",
      "answer": "circle",
      "solution": "A circle is round and has no corners."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "Which shape has four equal sides and square corners?",
      "answer": "square",
      "solution": "A square has four equal sides and four right angles."
    },
    {
      "id": "q4",
      "type": "text",
      "question": "Which shape looks like the outline of an egg?",
      "answer": "oval",
      "solution": "An oval is a rounded shape that can look like an egg outline."
    },
    {
      "id": "q5",
      "type": "text",
      "question": "Which shape has points like a decoration in the sky?",
      "answer": "star",
      "solution": "A star shape has points extending outwards."
    },
    {
      "id": "q6",
      "type": "text",
      "question": "Opposite of big?",
      "answer": "small",
      "solution": "Big and small describe opposite sizes."
    },
    {
      "id": "q7",
      "type": "text",
      "question": "Opposite of long?",
      "answer": "short",
      "solution": "Long and short describe opposite lengths."
    },
    {
      "id": "q8",
      "type": "text",
      "question": "Opposite of wide?",
      "answer": "narrow",
      "solution": "Wide and narrow describe opposite widths."
    },
    {
      "id": "q9",
      "type": "text",
      "question": "A giraffe is ___. (tall or short)",
      "answer": "tall",
      "solution": "A giraffe has a long neck and stands high above the ground."
    },
    {
      "id": "q10",
      "type": "text",
      "question": "A tiny ant is ___. (big or small)",
      "answer": "small",
      "solution": "Tiny means very small."
    }
  ],
  "summary": "Name familiar shapes and describe objects using simple size words.",
