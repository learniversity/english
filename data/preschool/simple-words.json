  "examples": [
    {
      "question": "Blend b-a-g.",
      "steps": [
        "Say the sounds, then join them without pauses."
      ],
      "answer": "bag"
    },
    {
      "question": "Blend n-e-t.",
      "steps": [
        "Say /n/, the short e sound and /t/."
      ],
      "answer": "net"
    },
    {
      "question": "Blend p-i-g.",
      "steps": [
        "Join the three sounds to read pig."
      ],
      "answer": "pig"
    },
    {
      "question": "Blend f-o-x.",
      "steps": [
        "The letter x represents /ks/ here."
      ],
      "answer": "fox"
    },
    {
      "question": "Blend c-u-p.",
      "steps": [
        "Join the sounds to read cup."
      ],
      "answer": "cup"
    }
