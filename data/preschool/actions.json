  "exercises": [
    {
      "id": "q1",
      "type": "text",
      "question": "I ___ a picture. (draw or sleep)",
      "answer": "draw",
      "solution": "Use the action for making a picture with a pencil."
    },
    {
      "id": "q2",
      "type": "text",
      "question": "I ___ water. (drink or sing)",
      "answer": "drink",
      "solution": "Water is something we drink, not sing."
    },
    {
      "id": "q3",
      "type": "text",
      "question": "I ___ my hands. (clap or read)",
      "answer": "clap",
      "solution": "Clapping means bringing your hands together."
    },
    {
      "id": "q4",
      "type": "text",
