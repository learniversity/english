  "rules": [
    "Say the number words slowly from zero to ten, then eleven to twenty.",
    "Ask a grown-up to say a number and point to its card.",
    "Use one with a singular noun and two or more with plural nouns: one cup, two cups."
  ],
  "examples": [
    {
      "question": "Read: 3 birds.",
      "steps": [
        "Say the number word before the object."
      ],
      "answer": "three birds"
    },
    {
      "question": "Read: 8 pencils.",
      "steps": [
        "The English word for 8 is eight."
      ],
      "answer": "eight pencils"
    },
    {
      "question": "How do you say 12?",
      "steps": [
        "Listen and repeat the number name."
      ],
      "answer": "twelve"
    },
    {
      "question": "Read: 15 flowers.",
      "steps": [
        "Say fifteen, then flowers."
      ],
      "answer": "fifteen flowers"
    },
    {
      "question": "How do you say 20?",
      "steps": [
        "Say the number word aloud."
      ],
      "answer": "twenty"
    }
  ],
